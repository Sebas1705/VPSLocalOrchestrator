[Unit]
Description=VPS Local Orchestrator API
After=network.target

[Service]
Type=simple
User=sebss
WorkingDirectory=/home/sebss/apps/VPSLocalOrchestrator/api/dist
ExecStart=/home/sebss/.nvm/versions/node/v24.11.1/bin/node index.js
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vps-orchestrator

# Defaults. EnvironmentFile wins over Environment= whatever the order, so a line
# in api/.env overrides these: API_HOST=<address> is how to listen elsewhere, and
# an old API_HOST=0.0.0.0 left in that file keeps the API exposed.
Environment="NODE_ENV=production"
Environment="API_HOST=127.0.0.1"
Environment="PORT=3000"
# Project settings (API_TOKEN, SECRET_KEY, etc.)
EnvironmentFile=/home/sebss/apps/VPSLocalOrchestrator/api/.env

[Install]
WantedBy=multi-user.target
