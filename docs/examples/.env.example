# API Token para operaciones privilegiadas
# Genera un token seguro: openssl rand -hex 32
API_TOKEN=mi-token-secreto-123

# Clave AES-256-GCM para cifrado de secretos (base64 32 bytes)
# Ejemplo: openssl rand -base64 32
SECRET_KEY=

# Puerto en el que escucha la API
PORT=3000

# Contraseña de sudo para comandos privilegiados
# NOTA: Para seguridad máxima, configura sudoers sin NOPASSWD
SUDO_PASSWORD=tu-contraseña-aqui

# Nivel de log: debug, info, warn, error
LOG_LEVEL=info

# Habilitar/deshabilitar endpoints privilegiados
ENABLE_PRIVILEGED_ENDPOINTS=true

# Máximo timeout en ms para comandos
MAX_COMMAND_TIMEOUT=300000

# Permitir ejecución de comandos con sudo
ALLOW_SUDO_COMMANDS=true

# Rutas de scripts permitidos (separadas por coma)
ALLOWED_SCRIPT_PATHS=/home/sebss/apps/VPSLocalOrchestrator/scripts

# Email para alertas de operaciones críticas (opcional)
ALERT_EMAIL=

# Webhook para logging remoto (opcional)
WEBHOOK_LOG_URL=
