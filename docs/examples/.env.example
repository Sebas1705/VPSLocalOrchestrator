############################
# VPS Local Orchestrator   #
# Example .env (template)  #
############################

# API token for privileged endpoints (generate securely)
# openssl rand -hex 32
API_TOKEN=your-generated-token-here

# AES-256-GCM key for secrets (32 bytes base64)
# openssl rand -base64 32
SECRET_KEY=

# API port
PORT=3000

# Sudo password for privileged commands
# Prefer sudoers without password for specific commands
SUDO_PASSWORD=

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Enable/disable privileged endpoints
ENABLE_PRIVILEGED_ENDPOINTS=true

# Max command timeout in ms
MAX_COMMAND_TIMEOUT=300000

# Allow commands with sudo
ALLOW_SUDO_COMMANDS=true

# Allowed script paths (comma separated)
ALLOWED_SCRIPT_PATHS=/home/sebss/apps/VPSLocalOrchestrator/scripts

# Alert email (optional)
ALERT_EMAIL=

# Remote webhook for logs (optional)
WEBHOOK_LOG_URL=
