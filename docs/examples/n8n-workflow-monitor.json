{
  "name": "Monitor Sistema - Alerta CPU/Memoria Alta",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtMinute": 5
            }
          ]
        }
      },
      "name": "Cada 5 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [250, 300],
      "id": "schedule-trigger"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://127.0.0.1:3000/api/resources",
        "options": {}
      },
      "name": "Obtener Recursos Sistema",
      "type": "n8n-nodes-base.httpRequest",
      "position": [450, 300],
      "id": "get-resources"
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.data.cpu.usage }}",
              "operation": "larger",
              "value2": 80
            }
          ]
        }
      },
      "name": "CPU > 80%?",
      "type": "n8n-nodes-base.if",
      "position": [650, 200],
      "id": "check-cpu"
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.data.memory.usagePercent }}",
              "operation": "larger",
              "value2": 90
            }
          ]
        }
      },
      "name": "Memoria > 90%?",
      "type": "n8n-nodes-base.if",
      "position": [650, 400],
      "id": "check-memory"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:3000/api/command/execute",
        "jsonParameters": true,
        "bodyParametersJson": "={\n  \"command\": \"ps aux --sort=-%cpu | head -n 10\"\n}"
      },
      "name": "Obtener Top CPU",
      "type": "n8n-nodes-base.httpRequest",
      "position": [850, 200],
      "id": "top-cpu"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:3000/api/command/execute",
        "jsonParameters": true,
        "bodyParametersJson": "={\n  \"command\": \"ps aux --sort=-%mem | head -n 10\"\n}"
      },
      "name": "Obtener Top Memoria",
      "type": "n8n-nodes-base.httpRequest",
      "position": [850, 400],
      "id": "top-memory"
    },
    {
      "parameters": {
        "message": "=⚠️ ALERTA: CPU en {{ $json.data.cpu.usage }}%\n\nProcesos consumiendo más CPU:\n{{ $node[\"Obtener Top CPU\"].json.result.stdout }}"
      },
      "name": "Enviar Alerta CPU",
      "type": "n8n-nodes-base.noOp",
      "position": [1050, 200],
      "id": "alert-cpu",
      "notes": "Reemplaza este nodo con tu método de notificación preferido (Email, Slack, Telegram, etc.)"
    },
    {
      "parameters": {
        "message": "=⚠️ ALERTA: Memoria en {{ $json.data.memory.usagePercent }}%\n\nProcesos consumiendo más memoria:\n{{ $node[\"Obtener Top Memoria\"].json.result.stdout }}"
      },
      "name": "Enviar Alerta Memoria",
      "type": "n8n-nodes-base.noOp",
      "position": [1050, 400],
      "id": "alert-memory",
      "notes": "Reemplaza este nodo con tu método de notificación preferido (Email, Slack, Telegram, etc.)"
    }
  ],
  "connections": {
    "Cada 5 minutos": {
      "main": [
        [
          {
            "node": "Obtener Recursos Sistema",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Obtener Recursos Sistema": {
      "main": [
        [
          {
            "node": "CPU > 80%?",
            "type": "main",
            "index": 0
          },
          {
            "node": "Memoria > 90%?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "CPU > 80%?": {
      "main": [
        [
          {
            "node": "Obtener Top CPU",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Memoria > 90%?": {
      "main": [
        [
          {
            "node": "Obtener Top Memoria",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Obtener Top CPU": {
      "main": [
        [
          {
            "node": "Enviar Alerta CPU",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Obtener Top Memoria": {
      "main": [
        [
          {
            "node": "Enviar Alerta Memoria",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
