{
  "name": "VPS Orchestrator - Ejemplos n8n",
  "nodes": [
    {
      "parameters": {
        "method": "GET",
        "url": "http://127.0.0.1:3000/health",
        "options": {}
      },
      "name": "Health Check",
      "type": "n8n-nodes-base.httpRequest",
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:3000/api/command/execute",
        "jsonParameters": true,
        "options": {},
        "bodyParametersJson": "={\n  \"command\": \"{{ $json.command }}\",\n  \"timeout\": 30000\n}"
      },
      "name": "Ejecutar Comando",
      "type": "n8n-nodes-base.httpRequest",
      "position": [450, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://127.0.0.1:3000/api/resources",
        "options": {}
      },
      "name": "Obtener Recursos",
      "type": "n8n-nodes-base.httpRequest",
      "position": [650, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://127.0.0.1:3000/api/resources/processes",
        "options": {
          "queryParameters": {
            "parameters": [
              {
                "name": "limit",
                "value": "10"
              }
            ]
          }
        }
      },
      "name": "Lista de Procesos",
      "type": "n8n-nodes-base.httpRequest",
      "position": [850, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:3000/api/command/batch",
        "jsonParameters": true,
        "options": {},
        "bodyParametersJson": "={\n  \"commands\": [\n    \"df -h\",\n    \"free -h\",\n    \"uptime\"\n  ]\n}"
      },
      "name": "Comandos en Lote",
      "type": "n8n-nodes-base.httpRequest",
      "position": [1050, 300]
    }
  ],
  "connections": {}
}
